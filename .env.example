# ─── Application ───────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
DEBUG=true

# ─── Database ──────────────────────────────────────────────────────
POSTGRES_USER=aiemployee
POSTGRES_PASSWORD=aiemployee_secret
POSTGRES_DB=ai_employee_db
DATABASE_URL=postgresql+asyncpg://aiemployee:aiemployee_secret@localhost:5432/ai_employee_db

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Google / Gemini ───────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_REGION=us-central1

# ─── Twilio ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── HubSpot CRM ───────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_access_token
HUBSPOT_PORTAL_ID=your_hubspot_portal_id

# ─── Google Calendar ───────────────────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_JSON=path/to/credentials.json
GOOGLE_CALENDAR_TOKEN_JSON=path/to/token.json

# ─── JWT Auth ──────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
